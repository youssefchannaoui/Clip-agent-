{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-check",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATA_DIR=/tmp/dc-mobile-data",
        "PORT=3411",
        "AUTH_REQUIRED=false",
        "BACKUP_ENABLED=false",
        "PROCESSING_MODE=local",
        "node",
        "src/server.js"
      ],
      "port": 3411
    },
    {
      "name": "signin-check",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATA_DIR=/tmp/dc-signin-data",
        "PORT=3412",
        "AUTH_REQUIRED=true",
        "BACKUP_ENABLED=false",
        "PROCESSING_MODE=local",
        "PUBLIC_BASE_URL=http://localhost:3412",
        "GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com",
        "GOOGLE_CLIENT_SECRET=test-secret",
        "node",
        "src/server.js"
      ],
      "port": 3412
    }
  ]
}