patch*/

# Installed JavaScript dependencies and alternative lockfiles generated by
# local tooling. This project deploys from the committed package-lock.json.
node_modules/
pnpm-lock.yaml

# Runtime state written by the app — not source
data/

# Working files from an agent session — probes, measurement scripts and the
# desktop screenshots that go in the reply. Delivered to the reader, never
# part of the product, and a session that captures a dozen PNGs must not
# leave the tree dirty for the next one.
scratchpad/

# Python bytecode from the worker and its tests
__pycache__/
*.py[cod]

# Local environment files. Production secrets live in Render and on the VPS;
# a stray .env in the repo is how they end up in a commit.
.env
.env.*
!.env.example
render.env

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Scratch space used when rendering page previews
.tmp-*/

# Generated by scripts/editor-preview.mjs — a local visual check, never shipped.
editor-preview*.html
.site-backup/
