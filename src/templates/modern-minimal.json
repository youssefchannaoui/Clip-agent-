{
  "id": "modern-minimal",
  "name": "Modern Minimal",
  "description": "Ultra-clean modern captions with restrained serif emphasis, Arabic-aware font fallback, and reliable readability on bright or dark footage.",
  "version": 1,
  "width": 1080,
  "height": 1920,
  "fitMode": "crop",
  "frameBackground": "#000000",
  "blurStrength": 22,
  "filterPreset": "natural",
  "brightness": 0,
  "contrast": 1.02,
  "saturation": 1,
  "gamma": 1,
  "sharpen": 0.35,
  "vignette": 0,
  "captionMode": "word",
  "captionFont": "DejaVu Sans",
  "captionHighlightFont": "DejaVu Serif",
  "captionArabicFont": "Amiri",
  "captionHighlightItalic": true,
  "captionHighlightGlow": 5,
  "captionFontSize": 82,
  "captionPrimary": "#FFFFFF",
  "captionHighlight": "#FFFFFF",
  "captionOutline": "#111111",
  "captionOutlineWidth": 3,
  "captionShadow": 2,
  "captionBackground": "#000000",
  "captionBackgroundOpacity": 0,
  "captionPosition": "middle",
  "captionHorizontal": "center",
  "captionMarginV": 145,
  "captionMarginH": 90,
  "captionMaxWords": 5,
  "captionStackMaxWords": 4,
  "captionStackProbability": 0,
  "captionClearPause": 0.42,
  "captionLineHeight": 0.92,
  "captionUppercase": false,
  "hookEnabled": false,
  "hookDuration": 0.5,
  "hookFontSize": 24,
  "hookColor": "#FFFFFF",
  "hookBackground": "#000000",
  "hookBackgroundOpacity": 0,
  "watermark": "@DEENCLIPPED",
  "watermarkFontSize": 24,
  "watermarkColor": "#FFFFFF",
  "watermarkOpacity": 72,
  "watermarkPosition": "bottom-center",
  "watermarkMarginV": 175,
  "watermarkMarginH": 48,
  "brandLineEnabled": false,
  "brandLineColor": "#FFFFFF",
  "brandLineHeight": 4,
  "voiceEnhance": true,
  "smartFramingEnabled": true,
  "smartFramingBias": "auto",
  "smartFramingPadding": 0.16,
  "smartFramingZoom": 1.02
}
